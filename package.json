{
    "name":  "dsh-sidebar-sections",
    "version":  "1.0.5",
    "description":  "Collapsible sections for the DSH sidebar: fold the functions list, the workspace list and the footer status area behind labelled header rows. Sections are identified by position, so cards the host or other plugins append to the sidebar footer are folded automatically (client-only DOM enhancement, keeps the React tree untouched).",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/",
                  "cordis.patch.yml",
                  "dsh.plugin.json",
                  "README.md",
                  "README.zh.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           }
            },
    "keywords":  [
                     "dsh",
                     "deepseek-harness",
                     "plugin",
                     "sidebar",
                     "collapse",
                     "ui"
                 ],
    "engines":  {
                    "node":  "\u003e=22.6.0"
                },
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/LeeScenic/dsh-sidebar-sections.git"
                   },
    "homepage":  "https://github.com/LeeScenic/dsh-sidebar-sections#readme",
    "bugs":  {
                 "url":  "https://github.com/LeeScenic/dsh-sidebar-sections/issues"
             },
    "author":  "LeeScenic"
}
